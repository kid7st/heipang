{
  "name": "heipang",
  "version": "0.4.2",
  "description": "HEIPANG — fast, model-agnostic desktop GUI for pi",
  "main": "./out/main/index.js",
  "author": "elylyly",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:performance": "npm run build && node scripts/performance-regression.mjs",
    "test:deepseek": "node scripts/deepseek-regression.mjs",
    "start": "electron-vite preview",
    "pack:mac": "electron-vite build && electron-builder --mac --arm64",
    "pack:mac:dir": "electron-vite build && electron-builder --mac --arm64 --dir",
    "pack:win": "electron-vite build && electron-builder --win --x64",
    "pack:meta:mac": "electron-vite build && electron-builder --config electron-builder.meta.yml --mac --arm64",
    "pack:meta:mac:dir": "electron-vite build && electron-builder --config electron-builder.meta.yml --mac --arm64 --dir",
    "pack:meta:win": "electron-vite build && electron-builder --config electron-builder.meta.yml --win --x64"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.99.1",
    "@earendil-works/pi-ai": "^0.99.1",
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.7.0",
    "virtua": "^0.49.1",
    "vite": "^7.3.5"
  },
  "build": {
    "appId": "com.elylyly.heipang",
    "productName": "HEIPANG",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@earendil-works/**",
      "node_modules/jiti/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": false,
      "artifactName": "${productName}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    }
  }
}
